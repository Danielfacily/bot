ENVIRONMENT=production

# ── Banco de dados e cache ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://bot:bot@postgres:5432/trading_bot
REDIS_URL=redis://redis:6379/0

# ── Credenciais da Binance (MAINNET) ──────────────────────────────────────────
BINANCE_API_KEY=FnWOksUdETjGqMloDiBS4W9HAyAUPTqZov2z5oYe33sz8yPC6bW5QFxMQHLLkIha
BINANCE_API_SECRET=aStMi3HIGf5phNGXeAjdTIpYkAIUXKLaCXo3xKLb3DXRnEx7eAVa7JpbmQdU3Jjj
BINANCE_RECV_WINDOW=60000

# ── Modo de operação PRODUÇÃO ──────────────────────────────────────────────────
EXCHANGE_MODE=mainnet
TRADING_MODE=live
ENABLE_MAINNET=true
DRY_RUN_FORCE=false

# ── Alavancagem — perfil 10x-20x ──────────────────────────────────────────────
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=20

# ── Margem por operação (USDT) ─────────────────────────────────────────────────
MIN_MARGIN_USDT=5.0
MAX_MARGIN_USDT=10.0

# ── Parâmetros de entrada ──────────────────────────────────────────────────────
MIN_SIGNAL_SCORE=70.0
PRIMARY_TIMEFRAME=15m
CONFIRMATION_TIMEFRAME=1h

# ── Gestão de risco ────────────────────────────────────────────────────────────
MAX_RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=5.0
MAX_DAILY_PROFIT_PCT=10.0
MAX_TRADES_PER_DAY=20
TRAILING_STOP_ENABLED=true
BREAK_EVEN_ENABLED=true
ISOLATED_MARGIN=true

# ── Scanner e estratégia ───────────────────────────────────────────────────────
SCANNER_INTERVAL_SECONDS=20
STRATEGY_INTERVAL_SECONDS=30
QUOTE_ASSET=USDT
MIN_QUOTE_VOLUME=20000000
MAX_SPREAD_PCT=0.12
PAPER_INITIAL_BALANCE=1000
