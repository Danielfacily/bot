APP_NAME=Binance Futures USDT-M Trading Bot
ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://bot:bot@postgres:5432/trading_bot
REDIS_URL=redis://redis:6379/0

# Chaves da Binance Futures. Nunca coloque segredo no código.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet por padrão.
BINANCE_TESTNET_BASE_URL=https://demo-fapi.binance.com
BINANCE_MAINNET_BASE_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binancefuture.com
EXCHANGE_MODE=testnet
TRADING_MODE=paper

# Segurança: ordens reais ficam bloqueadas mesmo em Testnet até você mudar conscientemente.
DRY_RUN_FORCE=true
ENABLE_MAINNET=false

MAX_LEVERAGE=20
DEFAULT_LEVERAGE=3
MAX_OPEN_POSITIONS=30
MAX_DAILY_LOSS_PCT=3.0
MAX_DAILY_PROFIT_PCT=6.0
MAX_RISK_PER_TRADE_PCT=0.5
MAX_TRADES_PER_DAY=50
ISOLATED_MARGIN=true
TRAILING_STOP_ENABLED=false
BREAK_EVEN_ENABLED=true

SCANNER_INTERVAL_SECONDS=20
STRATEGY_INTERVAL_SECONDS=30
QUOTE_ASSET=USDT
MIN_QUOTE_VOLUME=20000000
MAX_SPREAD_PCT=0.12
PAPER_INITIAL_BALANCE=10000
